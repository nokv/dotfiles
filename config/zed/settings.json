// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "proxy": "",
  "cli_default_open_behavior": "new_window",
  "buffer_font_family": ".ZedMono",
  "git": {
    "blame": {
      "show_avatar": true,
    },
    "inline_blame": {
      "show_commit_summary": true,
    },
  },
  "calls": {
    "mute_on_join": true,
  },
  "zoomed_padding": true,
  "active_pane_modifiers": {
    "inactive_opacity": 1.0,
  },
  "edit_predictions": {
    "provider": "copilot",
  },
  "git_panel": {
    "tree_view": true,
    "dock": "left",
  },
  "telemetry": {
    "diagnostics": false,
    "metrics": false,
  },
  "agent_servers": {
    "claude-acp": {
      "type": "registry",
    },
  },
  "terminal": {
    "env": {
      "FIG_NEW_SESSION": "\"1\"",
    },
    "font_family": "HackGen Console NF",
    "max_scroll_history_lines": 20000,
    "bell": "system",
  },
  "project_panel": {
    "indent_size": 15.0,
    "default_width": 240.0,
    "dock": "left",
    "auto_fold_dirs": false,
  },
  "agent": {
    "enabled": false,
    "button": false,
    "favorite_models": [],
    "model_parameters": [],
  },
  "multi_cursor_modifier": "alt",
  "sticky_scroll": {
    "enabled": false,
  },
  "minimap": {
    "show": "never",
  },
  "selection_highlight": true,
  "max_tabs": 6,
  "file_types": {
    "json": [".prettierrc"],
    "dotenv": [".env"],
    "javascript": ["*.js"],
    "shellscript": [".gitconfig"],
    "liquid": ["*.liquid"],
    "vue": ["*.vue"],
    "perl": ["*.cgi"],
    "php": ["*.php"],
    "css": ["*.css"],
  },
  "colorize_brackets": true,
  "linked_edits": true,
  "show_whitespaces": "none",
  "show_edit_predictions": true,
  "line_ending": "prefer_lf",
  "wrap_guides": [],
  "preferred_line_length": 1000,
  "tab_size": 2,
  "icon_theme": "Zed (Default)",
  "base_keymap": "VSCode",
  "ui_font_size": 16,
  "buffer_font_size": 15,
  "theme": {
    "mode": "dark",
    "light": "One Light",
    "dark": "Catppuccin Frappé",
  },
  "format_on_save": "on",
  "lsp": {
    "oxfmt": {
      "initialization_options": {
        "settings": {
          "fmt.configPath": null,
        },
      },
    },
  },
  "languages": {
    "Ruby": {
      "language_servers": ["ruby-lsp"],
    },
    "CSS": {
      "format_on_save": "on",
      "prettier": {
        "allowed": false,
      },
      "formatter": [
        {
          "language_server": {
            "name": "oxfmt",
          },
        },
      ],
    },
    "GraphQL": {
      "format_on_save": "on",
      "prettier": {
        "allowed": false,
      },
      "formatter": [
        {
          "language_server": {
            "name": "oxfmt",
          },
        },
      ],
    },
    "HTML": {
      "format_on_save": "on",
      "prettier": {
        "allowed": false,
      },
      "formatter": [
        {
          "language_server": {
            "name": "oxfmt",
          },
        },
      ],
    },
    "JavaScript": {
      "format_on_save": "on",
      "prettier": {
        "allowed": false,
      },
      "code_actions_on_format": {
        "source.fixAll.eslint": true,
      },
      "formatter": [
        {
          "language_server": {
            "name": "oxfmt",
          },
        },
      ],
    },
    "JSON": {
      "format_on_save": "on",
      "prettier": {
        "allowed": false,
      },
      "formatter": [
        {
          "language_server": {
            "name": "oxfmt",
          },
        },
      ],
    },
    "Markdown": {
      "format_on_save": "on",
      "prettier": {
        "allowed": false,
      },
      "formatter": [
        {
          "language_server": {
            "name": "oxfmt",
          },
        },
      ],
    },
    "TypeScript": {
      "format_on_save": "on",
      "prettier": {
        "allowed": false,
      },
      "code_actions_on_format": {
        "source.fixAll.eslint": true,
      },
      "formatter": [
        {
          "language_server": {
            "name": "oxfmt",
          },
        },
      ],
    },
    "TSX": {
      "format_on_save": "on",
      "prettier": {
        "allowed": false,
      },
      "code_actions_on_format": {
        "source.fixAll.eslint": true,
      },
      "formatter": [
        {
          "language_server": {
            "name": "oxfmt",
          },
        },
      ],
    },
    "YAML": {
      "format_on_save": "on",
      "prettier": {
        "allowed": false,
      },
      "formatter": [
        {
          "language_server": {
            "name": "oxfmt",
          },
        },
      ],
    },
  },
}
